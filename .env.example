# Nexus Science — environment configuration
#
# Copy this file to `.env` (in the same folder as nexus-science.exe) and
# fill in the values below. Lines starting with `#` are comments and
# ignored. DO NOT wrap values in quotes unless they contain spaces, and
# NEVER end a line with `\` — that backslash becomes part of the value.
#
# The binary loads this file automatically from the current directory
# on startup. No other configuration file is needed.

# ─── Model provider ────────────────────────────────────────────────────────
#
# This flag tells Nexus Science to speak the OpenAI API protocol instead
# of the default Anthropic protocol. Required for GLM / vLLM / OpenRouter
# / OpenAI / any OpenAI-compatible endpoint.
CLAUDE_CODE_USE_OPENAI=1

# ─── GLM 5.1 (NexusBrain internal vLLM server) ─────────────────────────────
#
# Default profile for the closed beta. The vLLM server speaks OpenAI
# protocol on /v1. If you point at a different provider, replace these
# three values.
OPENAI_BASE_URL=https://attended-avi-las-ddr.trycloudflare.com/v1
OPENAI_API_KEY=REPLACE_WITH_YOUR_API_KEY
OPENAI_MODEL=glm-5.1-fp8

# ─── Context-window safety ────────────────────────────────────────────────
#
# The default Nexus Science output budget is 32,000 tokens. For smaller
# models that could cause "400 maximum context length" errors. 16,384 is
# a conservative cap that works for GLM 5.1 FP8 at 128k context (the
# current NexusBrain default) while leaving plenty of room for the full
# system prompt and multi-turn conversation.
#
# If you see 400 context errors, lower this value. If you hit model
# output truncation, raise it up to 32,768 or the provider max.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384

# ─── Tool-result compatibility (GLM/vLLM workaround) ──────────────────────
#
# GLM 5.1 (and possibly other open-weight models hosted via vLLM) silently
# loses tool_result content when the preceding user message uses the
# OpenAI multi-block array form (`content: [{type:"text", text:...}, ...]`).
# Symptom: agent calls a tool, tool executes and returns real output, but
# the next turn reports "the tool returned no visible output".
#
# This flag tells the client to flatten text-only user content to a plain
# string, which GLM handles correctly. No effect when the content contains
# images or other non-text blocks — multimodal safety is preserved.
#
# Default providers (Anthropic native, OpenAI, Gemini via OpenRouter,
# Claude via Bedrock) already handle both forms fine — leave this flag
# OFF for them. Turn it ON only for GLM / vLLM / other known-bad
# providers. Default is OFF to preserve existing compatibility.
CLAUDE_CODE_FLATTEN_USER_CONTENT=1

# ─── Tool-result role rewrite (GLM/vLLM workaround, required) ─────────────
#
# GLM 5.1 chat template does not recognize the `role: tool` message type.
# Tool results sent in that form are silently dropped from the model's
# context, causing the agent to loop retrying tool calls because it
# never sees the result.
#
# Workaround: rewrite `role: tool` messages as `role: user` with an
# inline "[Tool result for call <id>]:" prefix. Empirically verified by
# direct vLLM replay: GLM parses the text form correctly and returns
# the expected answer on the first try.
#
# No effect on well-behaved providers (Anthropic, OpenAI, Gemini) —
# they parse the text form just as well. But we keep this flag OPT-IN
# to preserve OpenAI-standard semantics as the default.
#
# Turn this on for GLM / vLLM. REQUIRED for multi-turn tool use with
# GLM 5.1 as of April 2026.
CLAUDE_CODE_TOOL_RESULT_AS_USER=1

# ─── Multimodal strip (GLM/vLLM workaround, required) ────────────────────
#
# GLM 5.1 is a text-only model. If any tool returns an image block —
# notably ReadPDF, which renders PDF pages as images — the request fails
# with HTTP 400 "zai-org/GLM-5.1-FP8 is not a multimodal model" and the
# agent enters a retry loop because the same failing content stays in
# the conversation history forever.
#
# This flag tells the client to replace image blocks with a short text
# placeholder before sending to the provider. Tool round-trips still
# work (the agent gets a response saying "image was here"), and the
# agent can fall back to text extraction (pdftotext, etc.) when it
# notices the placeholder.
#
# Turn this on for any text-only provider (GLM, most local models).
# Default is OFF to preserve multimodal support for GPT-4o, Claude,
# Gemini, Anthropic native, etc.
CLAUDE_CODE_STRIP_IMAGES=1

# ─── Alternative providers (commented) ─────────────────────────────────────
#
# OpenRouter (gemini, claude via openrouter, etc.) — uncomment and set
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=google/gemini-3-flash-preview
#
# Direct OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
#
# Local Ollama with OpenAI shim
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1:70b
